---
import { responsivePhoto } from "../lib/photos";
import portrait from "../assets/photos/profile.jpg";
import ocean from "../assets/photos/sea.jpg";
const avatar = await responsivePhoto(portrait, [320, 640], 80);
const background = await responsivePhoto(ocean, [640, 1440, 1920], 68);
const backgroundStyle = `--bg-small: url('${background.src}'); --bg-large: url('${background.large}');`;
---
<main class="home">
  <!-- 背景圖片：請放在 public/home-bg.jpg -->
  <div class="home-bg" style={backgroundStyle} aria-hidden="true"></div>

  <!-- 霧面遮罩：讓背景圖變淡，避免搶走文字焦點 -->
  <div class="home-overlay" aria-hidden="true"></div>

  <section class="hero">
    <img class="avatar" src={avatar.src} srcset={avatar.srcset} sizes="(max-width: 430px) 280px, (max-width: 720px) 300px, 230px" alt="Portrait of Ralf Tsai" width="230" height="230" fetchpriority="high" decoding="async" />

    <div class="hero-content">
      <p class="kicker">Hey!</p>

      <h1>I'm Ralf</h1>

      <p class="intro">
        Bridging ocean science, chemistry, and sustainability.
      </p>

      <p class="subintro">
        Researcher, storyteller, and creator of <strong lang="zh-Hant">如果無塑</strong>.
      </p>
      <div class="hero-actions" aria-label="Explore the website">
        <a class="primary-action" href="/blog">Explore my writing <span aria-hidden="true">↗</span></a>
        <a class="secondary-action" href="/about">About me</a>
        <a class="secondary-action" href="/links">Get in touch</a>
      </div>
    </div>
  </section>
</main>

<style>
  .home {
    position: relative;
    display: grid;

    /* 首頁區塊之間的距離 */
    gap: 64px;

    min-height: 72vh;
    z-index: 1;
  }

  /* 讓 header / footer 永遠在背景圖上方 */
  :global(.site-header),
  :global(.site-footer) {
    position: relative;
    z-index: 5;
  }

  .home-bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;

  /* 使用 public/sea.jpg 作為首頁背景 */
  background-image: var(--bg-large);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  opacity: 1;
  background-color: #e4eaf0;
}

  /* 背景上方霧面遮罩 */
  .home-overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;

    /* 遮罩透明度：
       rgba 最後一個數字越高，背景越淡、文字越清楚
       想背景更明顯：0.88 / 0.8 / 0.74 數字都調低一點 */
    background:
      linear-gradient(
        90deg,
        rgba(251, 252, 248, 0.88) 0%,
        rgba(251, 252, 248, 0.8) 48%,
        rgba(251, 252, 248, 0.74) 100%
      ),
      radial-gradient(
        circle at 20% 20%,
        rgba(168, 200, 240, 0.22),
        transparent 36%
      );
  }

  .hero {
    position: relative;
    z-index: 2;

    display: grid;

    /* 桌機版：左照片、右文字 */
    grid-template-columns: 230px 1fr;

    /* 頭貼和文字之間的距離 */
    gap: 52px;

    align-items: center;
    margin-top: 24px;
  }

  .avatar {
    /* 桌機版首頁頭貼尺寸 */
    width: 230px;
    height: 230px;

    object-fit: cover;
    object-position: center;

    border-radius: 999px;
    border: 0;
    box-shadow: 0 24px 58px rgba(26, 39, 68, 0.14);
  }

  .kicker {
    margin: 0 0 10px;
    color: #6c88ad;

    /* Hey! 字體大小 */
    font-size: 24px;

    font-weight: 750;
  }

  h1 {
    margin: 0;
    color: #1a2744;

    /* I'm Ralf 字體大小 */
    font-size: clamp(58px, 8vw, 88px);

    line-height: 1;
    letter-spacing: -0.055em;
    font-weight: 850;
  }

  .intro {
    max-width: 640px;
    margin: 22px 0 0;
    color: rgba(26, 39, 68, 0.74);

    /* 第一行介紹文字大小 */
    font-size: 21px;

    line-height: 1.65;
  }

  .subintro {
    max-width: 640px;
    margin: 10px 0 0;
    color: rgba(26, 39, 68, 0.58);

    /* 第二行補充文字大小 */
    font-size: 18px;

    line-height: 1.65;
  }

  .intro strong,
  .subintro strong {
    color: #1a2744;
    font-weight: 850;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    margin-top: 26px;
  }
  .hero-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    border: 1px solid rgba(26, 39, 68, .18);
    transition: background .2s ease, color .2s ease;
  }
  .primary-action { background: #1a2744; color: #fff; }
  .primary-action:hover { background: #365477; }
  .secondary-action { background: rgba(251,252,248,.72); color: #1a2744; }
  .secondary-action:hover { background: #e4edf8; }
  @media (max-width: 430px) {
    .hero-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .hero-actions a { padding-inline: 10px; min-height: 48px; }
    .hero-actions .primary-action { grid-column: 1 / -1; }
  }

  /* 手機版優化 */
  @media screen and (max-width: 720px) {
    .home {
      gap: 42px;
      min-height: auto;
    }

    .hero {
      grid-template-columns: 1fr;

      /* 手機版照片和文字之間的距離 */
      gap: 24px;

      justify-items: center;
      text-align: left;

      /* 手機版上方距離 */
      margin-top: 18px;
    }

    .avatar {
      /* 手機版頭貼尺寸：想更大就改 300px */
      width: min(78vw, 300px);
      height: min(78vw, 300px);

      border-width: 0;
      box-shadow: 0 28px 64px rgba(26, 39, 68, 0.16);
    }

    .hero-content {
      width: 100%;
      max-width: 520px;
      padding: 0 8px;
      box-sizing: border-box;
    }

    .kicker {
      /* 手機版 Hey! 字體 */
      font-size: 28px;
      margin-bottom: 8px;
    }

    h1 {
      /* 手機版 I'm Ralf 字體 */
      font-size: clamp(56px, 17vw, 82px);
      line-height: 0.95;
      letter-spacing: -0.06em;
    }

    .intro {
      margin-top: 22px;

      /* 手機版第一行介紹文字大小 */
      font-size: 20px;

      line-height: 1.55;
      max-width: 100%;
    }

    .subintro {
      margin-top: 8px;

      /* 手機版第二行補充文字大小 */
      font-size: 16.5px;

      line-height: 1.65;
      max-width: 100%;
    }

    .home-bg {
      /* 手機版背景圖更淡，避免干擾文字 */
      opacity: 0.18;
      background-image: var(--bg-small);
      background-position: center;
    }

    .home-overlay {
      background:
        linear-gradient(
          180deg,
          rgba(251, 252, 248, 0.9) 0%,
          rgba(251, 252, 248, 0.82) 52%,
          rgba(251, 252, 248, 0.9) 100%
        );
    }
  }

  /* 更小手機，例如 iPhone SE */
  @media screen and (max-width: 430px) {
    .avatar {
      width: min(69vw, 260px);
      height: min(69vw, 260px);
    }

    .kicker {
      font-size: 28px;
    }

    h1 {
      font-size: clamp(56px, 17vw, 76px);
    }

    .intro {
      font-size: 19.5px;
    }

    .subintro {
      font-size: 16px;
    }
  }
</style>