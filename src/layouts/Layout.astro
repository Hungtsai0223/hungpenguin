---
import { responsivePhoto } from "../lib/photos";
import penguin from "../assets/photos/penguin-icon.png";
const logo = await responsivePhoto(penguin, [72, 144], 88);
const {
  title = "Ralf Tsai",
  description = "Personal website of Chun-Hung Tsai.",
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navigation = [ { href: "/", label: "Home" }, { href: "/about", label: "About" }, { href: "/blog", label: "Works" }, { href: "/links", label: "Links" } ];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/penguin-icon.png" />
    <title>{title}</title>
  </head>

  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Ralf Tsai Home">
          <img src={logo.src} srcset={logo.srcset} sizes="70px" alt="Ralf Tsai icon" width="70" height="70" decoding="async" />
        </a>

        <nav class="nav-links" aria-label="Main navigation">
          {navigation.map(({ href, label }) => (
            <a href={href} aria-current={currentPath === href ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      </header>

      <slot />

      <footer class="site-footer">
        <div class="footer-links">
          <a href="/blog">Works</a>
          <a href="/about">About</a>
          <a href="/links">Links</a>
          <a href="https://www.linkedin.com/in/hungtsai0223/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://www.instagram.com/ifnoplastic.tw/" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="https://www.dcard.tw/@ralfwu0330" target="_blank" rel="noopener noreferrer">Dcard</a>
        </div>

        <p>© Chun-Hung Tsai. All rights reserved.</p>
      </footer>
    </div>
    <script>
      // Images are visible by default; animation is purely progressive enhancement.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.querySelectorAll<HTMLImageElement>("main img").forEach((img) => {
          if (!img.complete) {
            img.addEventListener("load", () => {
              if (typeof img.animate === "function") img.animate([{ opacity: .72 }, { opacity: 1 }], { duration: 260, easing: "ease-out" });
            }, { once: true });
          }
        });
        if ("IntersectionObserver" in window && typeof Element.prototype.animate === "function") {
          const observer = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.animate(
                [{ transform: "translateY(6px)", opacity: .92 }, { transform: "translateY(0)", opacity: 1 }],
                { duration: 420, easing: "ease-out" }
              );
              observer.unobserve(entry.target);
            }
          }, { threshold: .12 });
          document.querySelectorAll("main [data-reveal]").forEach((el) => observer.observe(el));
        }
      }
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #fbfcf8;
    color: #1a2744;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", "Noto Sans TC", "PingFang TC", sans-serif;
  }

  a {
    color: inherit;
  }

  .site-shell {
    min-height: 100svh;
    width: min(100% - 48px, 960px);
    margin: 0 auto;
    padding: 34px 0 46px;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-bottom: 86px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

   .brand img {
  /* 左上角 logo 尺寸：想更大就調 width / height */
  width: 70px;
  height: 70px;

  /* contain = 完整顯示 logo，不裁切 */
  object-fit: contain;

  /* 方形圓角：0px 是完全方形，16px 是柔和圓角 */
  border-radius: 14px;

  /* logo 背景色：你的粉霧藍 */
  background: #a8c8f0;

  /* 內距：讓 logo 不會貼邊 */
  padding: 6px;

  /* 陰影：想更簡潔可刪掉 */
  box-shadow: 0 10px 24px rgba(26, 39, 68, 0.08);
}

  .nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
  }

  .nav-links a {
    color: rgba(26, 39, 68, 0.62);
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    color: #1a2744;
  }
  .nav-links a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 7px;
    text-decoration-color: #6c88ad;
    text-decoration-thickness: 2px;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 4px 3px;
  }
  a:focus-visible {
    outline: 2px solid #365477;
    outline-offset: 4px;
    border-radius: 4px;
  }
  main img {
    background-color: #e4eaf0;
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .01ms !important;
      transition-duration: .01ms !important;
      scroll-behavior: auto !important;
    }
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 92px;
    padding-top: 24px;
    border-top: 1px solid rgba(26, 39, 68, 0.12);
    color: rgba(26, 39, 68, 0.56);
    font-size: 14px;
  }

  .footer-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-links a {
    text-decoration: none;
  }

  .footer-links a:hover {
    color: #1a2744;
  }

  .site-footer p {
    margin: 0;
  }

  @media screen and (max-width: 720px) {
    .site-shell {
      width: min(100% - 30px, 960px);
      padding-top: 22px;
    }

    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 28px;
    }

    .nav-links {
      gap: 8px;
      width: 100%;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .nav-links a { font-size: 16px; padding-inline: 5px; }
    .site-footer { margin-top: 48px; }
    .footer-links a { padding-block: 8px; }

    .site-footer {
      flex-direction: column;
    }
  }
</style>