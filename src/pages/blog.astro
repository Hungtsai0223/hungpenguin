---
import Layout from "../layouts/Layout.astro";
import posts from "../data/dcard-posts.json";
const profile = "https://www.dcard.tw/@ralfwu0330";
---
<Layout title="Blog — Ralf Tsai" description="左旋葡萄糖的 Dcard 文章，分享環境永續、學習、旅行及生活。">
  <main class="blog" lang="zh-Hant">
    <header class="intro">
      <h1>我的文章</h1>
      <p>從環境永續到日常生活，記錄一路上的所見與所思。</p>
      <a class="profile" href={profile} target="_blank" rel="noopener noreferrer">左旋葡萄糖 · Dcard 個人牆 <span aria-hidden="true">↗</span></a>
    </header>
    <section class="feed" aria-label="Dcard 文章列表">
      {posts.map((post) => (
        <article class="post">
          <div class="meta">{post.category} <span aria-hidden="true">·</span> Dcard</div>
          <h2><a href={`${profile}/post/${post.id}`} target="_blank" rel="noopener noreferrer">{post.title}</a></h2>
          <p class="summary">{post.summary}</p>
          <a class="read" href={`${profile}/post/${post.id}`} target="_blank" rel="noopener noreferrer" aria-label={`閱讀原文：${post.title}`}>閱讀原文 <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </section>
    <footer class="feed-footer">
      <a class="all-posts" href={profile} target="_blank" rel="noopener noreferrer">瀏覽全部 Dcard 文章 <span aria-hidden="true">↗</span></a>
    </footer>
  </main>
</Layout>

<style>
  .blog { width: min(100%, 900px); margin: 0 auto; display: grid; gap: 28px; }
  .intro h1 { margin: 0 0 12px; font-size: clamp(34px, 5vw, 52px); line-height: 1.18; letter-spacing: -.035em; }
  .intro p { font-size: 17px; line-height: 1.65; color: #4d5c70; margin: 0 0 6px; }
  .profile { color: #365477; font-size: 14px; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; text-underline-offset: 4px; }
  .feed { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .post { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 22px; border: 1px solid #dce3e9; border-radius: 16px; background: rgba(255,255,255,.5); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: #547295; }
  h2 { margin: 0; font-size: 19px; line-height: 1.55; overflow-wrap: anywhere; }
  h2 a { text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .summary { margin: 0; color: #4d5c70; font-size: 15px; line-height: 1.75; overflow-wrap: anywhere; }
  .read { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; width: fit-content; color: #365477; font-weight: 700; font-size: 14px; text-decoration: none; }
  .read:hover { text-decoration: underline; }
  .feed-footer { display: flex; justify-content: center; }
  .all-posts { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 12px 22px; background: #1a2744; color: white; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 700; }
  @media (max-width: 650px) {
    .blog { gap: 20px; }
    .intro p { font-size: 16px; }
    .feed { grid-template-columns: 1fr; gap: 12px; }
    .post { padding: 17px; gap: 8px; }
    h2 { font-size: 17px; }
    .summary { font-size: 15px; }
    .all-posts { width: 100%; }
  }
</style>
