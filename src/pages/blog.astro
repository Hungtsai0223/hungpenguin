---
import Layout from "../layouts/Layout.astro";
import work from "../data/portfolio.json";
const dcard = "https://www.dcard.tw/@ralfwu0330";
const instagram = "https://www.instagram.com/ifnoplastic.tw/reels/";
---
<Layout title="Works — Ralf Tsai" description="Selected writing, environmental education videos, and QuoteSource, an iOS app by Ralf Tsai.">
  <main class="portfolio">
    <header class="intro">
      <h1>Selected Works</h1>
      <p>Writing, environmental storytelling, and digital products.</p>
      <nav class="jump" aria-label="Portfolio sections">
        <a href="#writing">Writing</a><a href="#videos">Videos</a><a href="#app">App</a>
      </nav>
    </header>
    <section id="writing" class="section">
      <header class="section-head">
        <div><p class="eyebrow">01 / Writing</p><h2>Dcard</h2><p>Knowledge sharing, learning, and environmental action.</p></div>
        <a class="text-link" href={dcard} target="_blank" rel="noopener noreferrer">All articles ↗</a>
      </header>
      <div class="articles">
        {work.articles.map(post => (
          <a class="article-card" href={post.url} target="_blank" rel="noopener noreferrer">
            {post.cover && <img class="article-cover" src={post.cover} alt="" width="480" height="270" loading="lazy" decoding="async" />}
            <div class="article-body">
              <span class="category">{post.category}</span>
              <h3 lang="zh-Hant">{post.title}</h3>
              <p>{post.description}</p>
              {(post.views != null || post.likes != null) && <p class="metrics">{post.views != null && <span>{post.views} views</span>}{post.likes != null && <span>{post.likes} likes</span>}</p>}
              <span class="text-link">Read article ↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>
    <section id="videos" class="section">
      <header class="section-head">
        <div><p class="eyebrow">02 / Environmental storytelling</p><h2><span lang="zh-Hant">如果無塑</span> · If No Plastic</h2><p>Short-form content on ocean conservation and sustainable living.</p></div>
        <a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer">All reels ↗</a>
      </header>
      <div class="reels">
        {work.reels.map((reel, i) => (
          <article class="reel">
            <button type="button" class:list={["reel-tile", { "has-cover": !!reel.cover }]} data-embed={reel.embed} data-url={reel.url} data-title={reel.title} aria-haspopup="dialog">
              {reel.cover && <img class="reel-cover" src={reel.cover} alt="" loading="lazy" decoding="async" />}
              <span class="reel-top"><span class="reel-number">FILM / 0{i+1}</span><svg class="play-symbol" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14l11-7z" fill="currentColor"/></svg></span>
              <span class="reel-details"><span class="reel-category">{reel.category}</span><span class="reel-title">{reel.title}</span><span class="reel-action">View video <span aria-hidden="true">↗</span></span></span>
            </button>
          </article>
        ))}
      </div>
      <dialog class="video-dialog" id="video-dialog" aria-labelledby="video-title">
        <div class="video-heading">
          <h3 id="video-title">Instagram Reel</h3>
          <button type="button" class="close-video" aria-label="Close video">×</button>
        </div>
        <div class="video-frame"></div>
        <a class="text-link video-source" href={instagram} target="_blank" rel="noopener noreferrer">Open on Instagram ↗</a>
      </dialog>
    </section>
    <section id="app" class="section">
      <header class="section-head"><div><p class="eyebrow">03 / Digital product</p><h2>QuoteSource</h2></div></header>
      <article class="app">
        <div class="app-copy">
          <img class="app-icon" src={work.app.icon} alt="QuoteSource app icon" width="76" height="76" loading="lazy" decoding="async" />
          <h3 lang="zh-Hant">句源</h3>
          <p>An iOS app for exploring the origins of quotations, evaluating source credibility, and building a personal collection of meaningful words.</p>
          <ul><li>Quotation source verification</li><li>Personal quote collection</li><li>Widgets &amp; Safari sharing</li></ul>
          <a class="store" href={work.app.url} target="_blank" rel="noopener noreferrer">View on the App Store ↗</a>
        </div>
        <div class="screens" aria-label="Official App Store screenshots">
          {work.app.screens.map((src,i)=><img src={src} alt={`QuoteSource App Store screenshot ${i+1}`} width="300" height="650" loading="lazy" decoding="async" />)}
        </div>
      </article>
    </section>
  </main>
</Layout>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("#video-dialog");
  const slot = dialog?.querySelector<HTMLElement>(".video-frame");
  const heading = dialog?.querySelector<HTMLElement>("#video-title");
  const source = dialog?.querySelector<HTMLAnchorElement>(".video-source");
  let trigger: HTMLButtonElement | null = null;

  document.querySelectorAll<HTMLButtonElement>(".reel-tile").forEach(button => {
    button.addEventListener("click", () => {
      const { embed, url, title } = button.dataset;
      if (!embed || !url || !embed.startsWith("https://www.instagram.com/reel/")) return;
      if (!dialog || !slot || !heading || !source || typeof dialog.showModal !== "function") {
        window.open(url, "_blank", "noopener,noreferrer");
        return;
      }
      trigger = button;
      heading.textContent = title || "Instagram Reel";
      source.href = url;
      const frame = document.createElement("iframe");
      frame.src = embed;
      frame.title = title || "Instagram Reel";
      frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      frame.allowFullscreen = true;
      frame.referrerPolicy = "strict-origin-when-cross-origin";
      frame.style.cssText = "display:block;width:100%;height:100%;border:0;";
      slot.replaceChildren(frame);
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>(".close-video")?.focus();
    });
  });
  dialog?.querySelector(".close-video")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", event => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener("close", () => { slot?.replaceChildren(); trigger?.focus(); trigger = null; });
</script>
<style>
  .portfolio { max-width: 960px; margin-inline: auto; display: grid; gap: 52px; }
  h1 { margin: 0 0 10px; font-size: clamp(38px, 6vw, 60px); letter-spacing: -.05em; line-height: 1.08; }
  p { color: #46566b; line-height: 1.6; margin: 0; }
  .intro > p { font-size: 18px; }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .jump a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border: 1px solid #d7e0e8; border-radius: 999px; font-size: 14px; font-weight: 700; text-decoration: none; }
  .jump a:hover { background: #e6edf5; }
  .section { display: grid; gap: 20px; border-top: 1px solid #dce3e9; padding-top: 25px; scroll-margin-top: 20px; }
  .section-head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 8px 20px; }
  .eyebrow { font-size: 12px; letter-spacing: .09em; text-transform: uppercase; font-weight: 750; color: #547295; margin-bottom: 6px; }
  h2 { margin: 0 0 6px; font-size: clamp(24px, 4vw, 34px); letter-spacing: -.025em; }
  .section-head p:not(.eyebrow) { font-size: 15px; }
  .text-link { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; font-weight: 700; color: #365477; text-decoration: none; }
  .text-link:hover { text-decoration: underline; }
  .articles,.reels { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14px; }
  .reels { width: 100%; }
  .article-card { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid #dce3e9; border-radius: 16px; background: rgba(255,255,255,.5); text-decoration: none; transition: border-color .15s; }
  .article-card:hover { border-color: #92a9c1; }
  .article-cover { width: 100%; aspect-ratio: 16/9; height: auto; object-fit: cover; display: block; }
  .article-body { display: flex; flex-direction: column; flex: 1; gap: 8px; padding: 18px; }
  .category { color: #547295; font-size: 12px; font-weight: 750; }
  h3 { margin: 0; font-size: 19px; line-height: 1.5; overflow-wrap: anywhere; }
  .article-body p { font-size: 14px; }
  .article-body .text-link { margin-top: auto; }
  .metrics { display: flex; gap: 10px; }
  .reel { min-width: 0; }
  .reel-tile { width: 100%; min-height: 190px; position: relative; display: flex; flex-direction: column; justify-content: space-between; text-align: left; gap: 22px; padding: 20px; overflow: hidden; color: #1a2744; background: linear-gradient(145deg,#edf3f8,#e3ebf2); border: 1px solid #d9e3ec; border-radius: 16px; font: inherit; cursor: pointer; transition: background .18s, border-color .18s, transform .18s; }
  .reel-tile:hover { background: #dce7f1; border-color: #9eb4ca; transform: translateY(-2px); }
  .reel-tile:focus-visible,.close-video:focus-visible { outline: 2px solid #365477; outline-offset: 3px; }
  .reel-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; z-index: 1; }
  .reel-number { font-size: 11px; font-weight: 800; letter-spacing: .1em; color: #547295; }
  .play-symbol { width: 40px; height: 40px; padding: 10px; background: #1a2744; color: #fff; border-radius: 50%; flex: 0 0 auto; }
  .reel-details { display: grid; gap: 6px; z-index: 1; }
  .reel-category { font-size: 12px; color: #547295; font-weight: 650; }
  .reel-title { font-size: 18px; line-height: 1.35; font-weight: 750; }
  .reel-action { color: #365477; font-size: 13px; font-weight: 700; margin-top: 4px; }
  .reel-tile.has-cover { min-height: 0; aspect-ratio: 9/13; color: white; }
  .reel-cover { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .has-cover::after { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent 30%,rgba(15,27,44,.75)); }
  .has-cover .reel-category,.has-cover .reel-action,.has-cover .reel-number { color: white; }
  .video-dialog { width: min(94vw, 460px); max-height: 94dvh; border: 0; border-radius: 18px; padding: 12px 14px; color: #1a2744; background: #fbfcf8; overflow: auto; box-shadow: 0 20px 90px rgba(26,39,68,.22); }
  .video-dialog::backdrop { background: rgba(13,23,40,.72); }
  .video-heading { display: flex; gap: 12px; justify-content: space-between; align-items: center; padding: 2px 2px 10px; }
  .video-heading h3 { font-size: 16px; }
  .close-video { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: #e7edf3; color: #1a2744; font-size: 28px; line-height: 1; cursor: pointer; flex: 0 0 auto; }
  .video-frame { height: min(70dvh, 650px); min-height: 230px; overflow: hidden; border-radius: 9px; background: #eef2f6; }
  .video-source { justify-content: center; width: 100%; }
  @media(prefers-reduced-motion:reduce) { .reel-tile { transition: none; } .reel-tile:hover { transform: none; } }
  .app { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.3fr); gap: 26px; align-items: center; background: #eef2f6; border: 1px solid #dce3e9; border-radius: 22px; padding: 26px; }
  .app-copy { display: grid; gap: 12px; justify-items: start; }
  .app-icon { display: block; width: 76px; height: 76px; border-radius: 18px; }
  .app-copy h3 { font-size: 29px; }
  .app-copy p,.app-copy li { font-size: 15px; }
  .app-copy ul { padding-left: 19px; margin: 0; color: #46566b; line-height: 1.7; }
  .store { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 10px 17px; color: #fff; background: #1a2744; border-radius: 999px; text-decoration: none; font-size: 14px; font-weight: 700; }
  .screens { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8px; }
  .screens img { width: 100%; height: auto; aspect-ratio: 300/650; object-fit: contain; border-radius: 10px; }
  @media (max-width: 680px) {
    .portfolio { gap: 34px; }
    .intro > p { font-size: 16px; }
    .articles { grid-template-columns: 1fr; gap: 10px; }
    .article-body { padding: 16px; gap: 5px; }
    h3 { font-size: 17px; }
    .reels { grid-template-columns: 1fr; gap: 10px; }
    .reel-tile { min-height: 0; display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 12px; padding: 16px; }
    .reel-top { grid-column: 2; grid-row: 1; flex-direction: column-reverse; align-items: center; gap: 6px; }
    .reel-details { grid-column: 1; grid-row: 1; }
    .reel-title { font-size: 16px; }
    .reel-tile.has-cover { aspect-ratio: 16/10; }
    .video-dialog { max-height: 94dvh; }
    .app { grid-template-columns: 1fr; padding: 19px; gap: 18px; }
    .store { width: 100%; }
  }
</style>
