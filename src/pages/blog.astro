---
import Layout from "../layouts/Layout.astro";

const featuredWriting = [
  {
    title: "臺北不是我的家，他告訴我要學會愛自己",
    platform: "Medium",
    category: "Essay",
    description:
      "A personal essay on living away from home, growing through uncertainty, and learning to care for oneself.",
    url: "https://medium.com/@hungtsai/%E8%87%BA%E5%8C%97%E4%B8%8D%E6%98%AF%E6%88%91%E7%9A%84%E5%AE%B6-%E4%BB%96%E5%91%8A%E8%A8%B4%E8%A6%81%E5%AD%B8%E6%9C%83%E6%84%9B%E8%87%AA%E5%B7%B1-cec14d26ac51",
    external: true,
  },
  {
    title: "池上好好，關於打工換宿這件事",
    platform: "Medium",
    category: "Travel writing",
    description:
      "A travel and life reflection from a work-exchange experience in Chishang, written with attention to place, pace, and memory.",
    url: "https://medium.com/@hungtsai/%E6%B1%A0%E4%B8%8A%E5%A5%BD%E5%A5%BD-%E9%97%9C%E6%96%BC%E6%89%93%E5%B7%A5%E6%8F%9B%E5%AE%BF%E9%80%99%E4%BB%B6%E4%BA%8B-57fb93b312d5",
    external: true,
  },
  {
    title: "如果無塑｜Environmental Education Notes",
    platform: "Instagram",
    category: "Sustainability",
    description:
      "Environmental education content on ocean issues, plastic-free living, vegetarian life, and everyday sustainability.",
    url: "https://www.instagram.com/ifnoplastic.tw/",
    external: true,
  },
];

const writingCollection = [
  {
    title: "臺北不是我的家，他告訴我要學會愛自己",
    platform: "Medium",
    category: "Essay",
    description:
      "A personal essay on living away from home, growing through uncertainty, and learning to care for oneself.",
    url: "https://medium.com/@hungtsai/%E8%87%BA%E5%8C%97%E4%B8%8D%E6%98%AF%E6%88%91%E7%9A%84%E5%AE%B6-%E4%BB%96%E5%91%8A%E8%A8%B4%E8%A6%81%E5%AD%B8%E6%9C%83%E6%84%9B%E8%87%AA%E5%B7%B1-cec14d26ac51",
    external: true,
  },
  {
    title: "池上好好，關於打工換宿這件事",
    platform: "Medium",
    category: "Travel writing",
    description:
      "A travel and life reflection from a work-exchange experience in Chishang.",
    url: "https://medium.com/@hungtsai/%E6%B1%A0%E4%B8%8A%E5%A5%BD%E5%A5%BD-%E9%97%9C%E6%96%BC%E6%89%93%E5%B7%A5%E6%8F%9B%E5%AE%BF%E9%80%99%E4%BB%B6%E4%BA%8B-57fb93b312d5",
    external: true,
  },
  {
    title: "家教，是為了陪伴一顆生命種子",
    platform: "Medium",
    category: "Education",
    description:
      "A reflective essay on tutoring, learning, companionship, and teaching as a form of care.",
    url: "https://medium.com/@hungtsai",
    external: true,
  },
  {
    title: "研究所推甄之路，我與海的距離",
    platform: "Medium",
    category: "Study notes",
    description:
      "A personal record of graduate school applications, oceanography, and finding an academic direction.",
    url: "https://medium.com/@hungtsai",
    external: true,
  },
  {
    title: "左旋葡萄糖｜Dcard Creator Works",
    platform: "Dcard",
    category: "Creator portfolio",
    description:
      "Long-form writing, campus observations, travel notes, and personal essays published on Dcard.",
    url: "https://www.dcard.tw/@ralfwu0330",
    external: true,
  },
  {
    title: "如果無塑｜Environmental Education Notes",
    platform: "Instagram",
    category: "Sustainability",
    description:
      "Environmental education content on ocean issues, plastic-free living, vegetarian life, and everyday sustainability.",
    url: "https://www.instagram.com/ifnoplastic.tw/",
    external: true,
  },
  {
    title: "Ocean & Mercury Research Notes",
    platform: "Research",
    category: "Oceanography",
    description:
      "Notes on environmental change, anthropogenic mercury emissions, energy structure, and data analysis.",
    url: "/about",
    external: false,
  },
];
---

<Layout
  title="Writing & Notes — Ralf Tsai"
  description="Essays, research notes, sustainability observations, and reflections by Chun-Hung Tsai."
>
  <main class="blog-page">
    <section class="page-hero" aria-labelledby="blog-title">
      <p class="section-label">Blog</p>
      <h1 id="blog-title">Writing &amp; Notes</h1>
      <p class="hero-copy">
        Essays, research notes, sustainability observations, and reflections from life by the sea.
      </p>
    </section>

    <section class="featured-section" aria-labelledby="featured-title">
      <div class="section-heading">
        <p class="section-label">Featured</p>
        <h2 id="featured-title">Featured Writing</h2>
      </div>

      <div class="featured-grid">
        {featuredWriting.map((item) => (
          <a
            class="featured-card"
            href={item.url}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
          >
            <span class="platform">{item.platform}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>

            <span class="card-footer">
              <span>{item.category}</span>
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M6 14 14 6M8 6h6v6" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="collection-section" aria-labelledby="collection-title">
      <div class="section-heading">
        <p class="section-label">Medium · Dcard · Sustainability · Research</p>
        <h2 id="collection-title">Writing Collection</h2>
      </div>

      <div class="writing-list">
        {writingCollection.map((item) => (
          <a
            class="writing-item"
            href={item.url}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
          >
            <div class="item-meta" aria-label={`${item.platform}, ${item.category}`}>
              <span>{item.platform}</span>
              <span>{item.category}</span>
            </div>

            <div class="item-body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>

            <span class="item-action" aria-hidden="true">
              <svg viewBox="0 0 20 20">
                <path d="M6 14 14 6M8 6h6v6" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .blog-page {
    display: grid;
    gap: 72px;
    width: min(100%, 920px);
    margin: 0 auto;
  }

  .page-hero {
    max-width: 760px;
    padding-top: 6px;
  }

  .section-label {
    margin: 0 0 10px;
    color: #6c88ad;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  h1 {
    margin: 0;
    color: #1a2744;
    font-size: 56px;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .hero-copy {
    max-width: 690px;
    margin: 20px 0 0;
    color: rgba(26, 39, 68, 0.68);
    font-size: 19px;
    line-height: 1.78;
  }

  .featured-section,
  .collection-section {
    display: grid;
    gap: 22px;
  }

  .section-heading {
    display: grid;
    gap: 4px;
  }

  h2 {
    margin: 0;
    color: #1a2744;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .featured-card,
  .writing-item {
    color: inherit;
    text-decoration: none;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .featured-card {
    min-height: 278px;
    display: flex;
    flex-direction: column;
    padding: 22px;
    border: 1px solid rgba(26, 39, 68, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.72);
  }

  .featured-card:hover,
  .writing-item:hover {
    transform: translateY(-2px);
    border-color: rgba(108, 136, 173, 0.46);
    background: rgba(255, 255, 255, 0.88);
  }

  .platform {
    width: fit-content;
    margin-bottom: 22px;
    padding: 5px 10px;
    border: 1px solid rgba(168, 200, 240, 0.7);
    border-radius: 999px;
    background: rgba(168, 200, 240, 0.22);
    color: rgba(26, 39, 68, 0.68);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.3;
  }

  h3 {
    margin: 0;
    color: #1a2744;
    font-size: 20px;
    line-height: 1.34;
    letter-spacing: 0;
  }

  .featured-card p,
  .writing-item p {
    margin: 10px 0 0;
    color: rgba(26, 39, 68, 0.66);
    font-size: 15.5px;
    line-height: 1.72;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    margin-top: auto;
    padding-top: 24px;
    color: rgba(26, 39, 68, 0.6);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.35;
  }

  svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .writing-list {
    display: grid;
    border-top: 1px solid rgba(26, 39, 68, 0.12);
  }

  .writing-item {
    display: grid;
    grid-template-columns: 170px 1fr auto;
    gap: 24px;
    align-items: start;
    padding: 24px 0;
    border-bottom: 1px solid rgba(26, 39, 68, 0.12);
  }

  .item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .item-meta span {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(168, 200, 240, 0.28);
    color: rgba(26, 39, 68, 0.68);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.3;
  }

  .item-action {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(26, 39, 68, 0.12);
    border-radius: 999px;
    color: #6c88ad;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }

  .writing-item:hover .item-action {
    background: rgba(168, 200, 240, 0.28);
    color: #1a2744;
  }

  @media screen and (max-width: 860px) {
    .blog-page {
      gap: 58px;
    }

    h1 {
      font-size: 46px;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .featured-card {
      min-height: 0;
    }

    .writing-item {
      grid-template-columns: 1fr auto;
      gap: 14px 18px;
    }

    .item-meta {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 520px) {
    .blog-page {
      gap: 48px;
    }

    .page-hero {
      padding-top: 0;
    }

    h1 {
      font-size: 38px;
      line-height: 1.08;
    }

    h2 {
      font-size: 24px;
    }

    h3 {
      font-size: 18px;
    }

    .hero-copy {
      margin-top: 16px;
      font-size: 16.5px;
      line-height: 1.72;
    }

    .featured-card {
      padding: 20px;
      border-radius: 16px;
    }

    .writing-item {
      grid-template-columns: 1fr;
      padding: 22px 0;
    }

    .item-action {
      display: none;
    }
  }
</style>
