---
import Layout from "../layouts/Layout.astro";
import { responsivePhoto } from "../lib/photos";
import ocean from "../assets/photos/sea.jpg";
const oceanCover = await responsivePhoto(ocean, [320, 640], 74);

const featuredWriting = [
  {
    title: "Taipei Is Not My Home: Learning to Love Myself",
    platform: "Medium",
    category: "Essay",
    cover: "essay",
    description:
      "Finding self-compassion while living away from home.",
    url: "https://medium.com/@hungtsai/%E8%87%BA%E5%8C%97%E4%B8%8D%E6%98%AF%E6%88%91%E7%9A%84%E5%AE%B6-%E4%BB%96%E5%91%8A%E8%A8%B4%E8%A6%81%E5%AD%B8%E6%9C%83%E6%84%9B%E8%87%AA%E5%B7%B1-cec14d26ac51",
    external: true,
  },
  {
    title: "A Slower Life in Chishang: My Work Exchange",
    platform: "Medium",
    category: "Travel writing",
    cover: "travel",
    description:
      "Finding a slower rhythm through a work exchange in Chishang.",
    url: "https://medium.com/@hungtsai/%E6%B1%A0%E4%B8%8A%E5%A5%BD%E5%A5%BD-%E9%97%9C%E6%96%BC%E6%89%93%E5%B7%A5%E6%8F%9B%E5%AE%BF%E9%80%99%E4%BB%B6%E4%BA%8B-57fb93b312d5",
    external: true,
  },
  {
    title: "If No Plastic — Environmental Education",
    platform: "Instagram",
    category: "Sustainability",
    cover: "ocean",
    description:
      "Ocean conservation and everyday sustainability.",
    url: "https://www.instagram.com/ifnoplastic.tw/",
    external: true,
  },
];

const writingCollection = [
  {
    title: "Taipei Is Not My Home: Learning to Love Myself",
    platform: "Medium",
    category: "Essay",
    description:
      "A personal essay on living away from home, growing through uncertainty, and learning to care for oneself.",
    url: "https://medium.com/@hungtsai/%E8%87%BA%E5%8C%97%E4%B8%8D%E6%98%AF%E6%88%91%E7%9A%84%E5%AE%B6-%E4%BB%96%E5%91%8A%E8%A8%B4%E8%A6%81%E5%AD%B8%E6%9C%83%E6%84%9B%E8%87%AA%E5%B7%B1-cec14d26ac51",
    external: true,
  },
  {
    title: "A Slower Life in Chishang: My Work Exchange",
    platform: "Medium",
    category: "Travel writing",
    description:
      "A travel and life reflection from a work-exchange experience in Chishang.",
    url: "https://medium.com/@hungtsai/%E6%B1%A0%E4%B8%8A%E5%A5%BD%E5%A5%BD-%E9%97%9C%E6%96%BC%E6%89%93%E5%B7%A5%E6%8F%9B%E5%AE%BF%E9%80%99%E4%BB%B6%E4%BA%8B-57fb93b312d5",
    external: true,
  },
  {
    title: "Tutoring: Nurturing a Seed of Life",
    platform: "Medium",
    category: "Education",
    description:
      "A reflective essay on tutoring, learning, companionship, and teaching as a form of care.",
    url: "https://medium.com/@hungtsai",
    external: true,
  },
  {
    title: "My Road to Graduate School and the Sea",
    platform: "Medium",
    category: "Study notes",
    description:
      "A personal record of graduate school applications, oceanography, and finding an academic direction.",
    url: "https://medium.com/@hungtsai",
    external: true,
  },
  {
    title: "Dcard — Selected Writing",
    platform: "Dcard",
    category: "Creator portfolio",
    description:
      "Long-form writing, campus observations, travel notes, and personal essays published on Dcard.",
    url: "https://www.dcard.tw/@ralfwu0330",
    external: true,
  },
  {
    title: "If No Plastic — Environmental Education",
    platform: "Instagram",
    category: "Sustainability",
    description:
      "Environmental education content on ocean issues, plastic-free living, vegetarian life, and everyday sustainability.",
    url: "https://www.instagram.com/ifnoplastic.tw/",
    external: true,
  },
  {
    title: "Ocean & Mercury Research",
    platform: "Research",
    category: "Oceanography",
    description:
      "An overview of my academic research on environmental change, anthropogenic mercury emissions, and energy systems.",
    url: "/about#research",
    external: false,
  },
];
const moreWriting = writingCollection.filter(
  (item) => !featuredWriting.some((featured) => featured.title === item.title)
);
---

<Layout
  title="Writing & Notes — Ralf Tsai"
  description="Essays, research notes, sustainability observations, and reflections by Chun-Hung Tsai."
>
  <main class="blog-page">
    <section class="page-hero" aria-labelledby="blog-title">
      <p class="section-label">Blog</p>
      <h1 id="blog-title">Writing &amp; Notes</h1>
      <p class="hero-copy">
        Essays, research notes, sustainability observations, and reflections from life by the sea.
      </p>
    </section>

    <section class="featured-section" aria-labelledby="featured-title" data-reveal>
      <div class="section-heading">
        <p class="section-label">Featured</p>
        <h2 id="featured-title">Featured Writing</h2>
      </div>

      <div class="featured-grid">
        {featuredWriting.map((item) => (
          <a
            class="featured-card"
            href={item.url}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
          >
            <div class:list={["cover", item.cover]} aria-hidden="true">
              {item.cover === "ocean" ? (
                <img src={oceanCover.src} srcset={oceanCover.srcset} sizes="(max-width: 520px) 96px, (max-width: 860px) 45vw, 290px" alt="" loading="lazy" decoding="async" width="320" height="150" />
              ) : (
                <svg viewBox="0 0 320 150" preserveAspectRatio="xMidYMid slice">
                  {item.cover === "essay" ? (
                    <g fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M55 117V59l42-30 42 30v58M75 117V83h44v34M166 117V48h35v69M208 117V23h36v94M252 117V66h23v51M36 117h257" />
                      <circle cx="157" cy="33" r="13" />
                    </g>
                  ) : (
                    <g fill="none" stroke="currentColor" stroke-width="2.5">
                      <circle cx="238" cy="38" r="22" />
                      <path d="M0 89 77 32 159 89 205 62 320 99M0 113Q80 93 160 113T320 113M0 134Q80 114 160 134T320 134M122 150l38-61 35 61" />
                    </g>
                  )}
                </svg>
              )}
            </div>
            <span class="platform">{item.platform} · Chinese content</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>

            <span class="card-footer">
              <span>{item.category}</span>
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M6 14 14 6M8 6h6v6" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="collection-section" aria-labelledby="collection-title" data-reveal>
      <div class="section-heading">
        <p class="section-label">Medium · Dcard · Sustainability · Research</p>
        <h2 id="collection-title">More Writing &amp; Research</h2>
      </div>

      <div class="writing-list">
        {moreWriting.map((item) => (
          <a
            class="writing-item"
            href={item.url}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
          >
            <div class="item-meta" aria-label={`${item.platform}, ${item.category}`}>
              <span>{item.platform}</span>
              <span>{item.category}</span>
              {item.external && <span>Chinese content</span>}
            </div>

            <div class="item-body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              {item.url === "https://medium.com/@hungtsai" && <p class="source-note">Find this essay on my Medium profile.</p>}
            </div>

            <span class="item-action" aria-hidden="true">
              <svg viewBox="0 0 20 20">
                <path d="M6 14 14 6M8 6h6v6" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .blog-page {
    display: grid;
    gap: 72px;
    width: min(100%, 920px);
    margin: 0 auto;
  }

  .page-hero {
    max-width: 760px;
    padding-top: 6px;
  }

  .section-label {
    margin: 0 0 10px;
    color: #6c88ad;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  h1 {
    margin: 0;
    color: #1a2744;
    font-size: 56px;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .hero-copy {
    max-width: 690px;
    margin: 20px 0 0;
    color: rgba(26, 39, 68, 0.68);
    font-size: 19px;
    line-height: 1.78;
  }

  .featured-section,
  .collection-section {
    display: grid;
    gap: 22px;
  }

  .section-heading {
    display: grid;
    gap: 4px;
  }

  h2 {
    margin: 0;
    color: #1a2744;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .featured-card,
  .writing-item {
    color: inherit;
    text-decoration: none;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .featured-card {
    min-height: 278px;
    display: flex;
    flex-direction: column;
    padding: 22px;
    border: 1px solid rgba(26, 39, 68, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.72);
  }

  .featured-card:hover,
  .writing-item:hover {
    transform: translateY(-2px);
    border-color: rgba(108, 136, 173, 0.46);
    background: rgba(255, 255, 255, 0.88);
  }

  .cover {
    height: 150px;
    margin: -22px -22px 18px;
    border-radius: 17px 17px 0 0;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: #e4edf5;
    color: #587390;
  }
  .cover svg { width: 100%; height: 100%; stroke-width: 2.5; }
  .cover.travel { background: #e8eee3; color: #688272; }
  .cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .source-note { font-size: 13px !important; color: #365477 !important; }
  .platform {
    width: fit-content;
    margin-bottom: 14px;
    padding: 5px 10px;
    border: 1px solid rgba(168, 200, 240, 0.7);
    border-radius: 999px;
    background: rgba(168, 200, 240, 0.22);
    color: rgba(26, 39, 68, 0.68);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.3;
  }

  h3 {
    margin: 0;
    color: #1a2744;
    font-size: 20px;
    line-height: 1.34;
    letter-spacing: 0;
  }

  .featured-card p,
  .writing-item p {
    margin: 10px 0 0;
    color: rgba(26, 39, 68, 0.66);
    font-size: 15.5px;
    line-height: 1.72;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    margin-top: auto;
    padding-top: 24px;
    color: rgba(26, 39, 68, 0.6);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.35;
  }

  svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .writing-list {
    display: grid;
    border-top: 1px solid rgba(26, 39, 68, 0.12);
  }

  .writing-item {
    display: grid;
    grid-template-columns: 170px 1fr auto;
    gap: 24px;
    align-items: start;
    padding: 24px 0;
    border-bottom: 1px solid rgba(26, 39, 68, 0.12);
  }

  .item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .item-meta span {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(168, 200, 240, 0.28);
    color: rgba(26, 39, 68, 0.68);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.3;
  }

  .item-action {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(26, 39, 68, 0.12);
    border-radius: 999px;
    color: #6c88ad;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }

  .writing-item:hover .item-action {
    background: rgba(168, 200, 240, 0.28);
    color: #1a2744;
  }

  @media screen and (max-width: 860px) {
    .blog-page {
      gap: 58px;
    }

    h1 {
      font-size: 46px;
    }

    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured-card {
      min-height: 0;
    }

    .writing-item {
      grid-template-columns: 1fr auto;
      gap: 14px 18px;
    }

    .item-meta {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 520px) {
    .blog-page {
      gap: 32px;
    }

    .page-hero {
      padding-top: 0;
    }

    h1 {
      font-size: 38px;
      line-height: 1.08;
    }

    h2 {
      font-size: 24px;
    }

    h3 {
      font-size: 18px;
    }

    .hero-copy {
      margin-top: 16px;
      font-size: 16.5px;
      line-height: 1.72;
    }

    .featured-grid { grid-template-columns: 1fr; gap: 12px; }
    .featured-card {
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      column-gap: 13px;
      row-gap: 6px;
      padding: 14px;
      border-radius: 16px;
      align-items: start;
    }
    .cover { grid-column: 1; grid-row: 1 / 5; height: 106px; width: 96px; margin: 0; border-radius: 10px; }
    .featured-card .platform { grid-column: 2; margin: 0; padding: 3px 6px; font-size: 10px; }
    .featured-card h3, .featured-card p, .featured-card .card-footer { grid-column: 2; }
    .featured-card h3 { font-size: 16px; }
    .featured-card p { font-size: 13.5px; line-height: 1.5; margin: 0; }
    .featured-card .card-footer { padding-top: 3px; font-size: 12px; }
    @media (max-width: 350px) {
      .featured-card { grid-template-columns: 72px minmax(0, 1fr); }
      .cover { width: 72px; height: 90px; }
    }
    .writing-item {
      grid-template-columns: 1fr;
      padding: 22px 0;
    }

    .item-action {
      display: none;
    }
  }
</style>
