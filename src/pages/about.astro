---
import Layout from "../layouts/Layout.astro";
import { responsivePhoto } from "../lib/photos";
import portrait from "../assets/photos/about-profile.jpg";
const avatar = await responsivePhoto(portrait, [200, 400, 600], 80);
---

<Layout title="About — Ralf Tsai" description="Oceanography, environmental education, and writing by Ralf Tsai.">
  <main class="page">
    <section class="about-hero">
      <img class="portrait" src={avatar.src} srcset={avatar.srcset} sizes="(max-width: 600px) 128px, 200px" alt="Portrait of Chun-Hung Tsai at the Institute of Oceanography" width="200" height="200" decoding="async" fetchpriority="high" />
      <div>
        <p class="kicker">About</p>
        <h1>A little about me.</h1>
        <p class="intro">I’m Ralf Tsai, from Kaohsiung, Taiwan. I connect science, sustainability, and storytelling.</p>
        <a class="profile-link" href="https://www.linkedin.com/in/hungtsai0223/" target="_blank" rel="noopener noreferrer">View LinkedIn profile <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <div class="sections">
      <section class="section" id="research" data-reveal>
        <h2>Education &amp; Research</h2>
        <ul>
          <li class="education-entry">
            <strong>National Taiwan University (NTU)</strong>
            <span class="degree">Master of Science (M.S.) — in progress</span>
            <span>Institute of Oceanography · Chemical Oceanography</span>
            <span class="education-note">Research: Global anthropogenic mercury emissions, energy transitions, and environmental data analysis.</span>
          </li>
          <li class="education-entry">
            <strong>National Pingtung University (NPTU)</strong>
            <span class="degree">Bachelor of Science (B.S.)</span>
            <span>Department of Applied Chemistry · Biochemistry track</span>
            <span class="education-note">Three Academic Excellence Awards. Undergraduate research on the protective effects of marine natural products against blue light-induced damage in ARPE-19 retinal pigment epithelial cells.</span>
          </li>
        </ul>
      </section>

      <section class="section experience-section" data-reveal>
        <h2>What I Do</h2>
        <p class="experience-intro">I bring science beyond the lab through education, community action, and creative projects.</p>
        <div class="experience-grid">
          <article class="experience">
            <p class="experience-kicker">Science Communication</p>
            <h3><a href="https://www.instagram.com/ifnoplastic.tw/" target="_blank" rel="noopener noreferrer"><span lang="zh-Hant">如果無塑</span> (@ifnoplastic.tw) ↗</a></h3>
            <p>I translate marine science and sustainability into accessible stories, photography, and short-form videos. In 2023, I independently organized three coastal cleanups combined with local heritage walks in southern Taiwan.</p>
            <a class="experience-link" href="/blog#videos">Explore video works →</a>
          </article>
          <article class="experience">
            <p class="experience-kicker">Ocean Education</p>
            <h3>Marine Education &amp; Youth Empowerment</h3>
            <p>Recipient of the 2026 Kuroshio Ocean Education Foundation grant. My project aims to train 4–6 young marine educators and develop reusable teaching materials on marine debris and waste prevention for high school students.</p>
          </article>
          <article class="experience">
            <p class="experience-kicker">Leadership &amp; Service</p>
            <h3>NTU Chongde Volunteer Club</h3>
            <p>As club president, I brought students together through volunteer service, plant-based cooking, and community activities, gaining hands-on experience in event planning, team coordination, and student engagement.</p>
          </article>
          <article class="experience">
            <p class="experience-kicker">International Exchange</p>
            <h3>JST Sakura Science Program</h3>
            <p>FY2025 Coordinator of the Taiwan Sakura Science Club Alumni (TSSCA). I contribute to Taiwan–Japan science exchange through alumni engagement, event organization, and cross-cultural collaboration.</p>
          </article>
          <article class="experience">
            <p class="experience-kicker">Community &amp; Industry</p>
            <h3>Professional Experience</h3>
            <p>My internships span community development in Pingtung and industry experience at TCI. In 2021, I helped organize heritage walks for families and document local artisans through podcasts, connecting storytelling with community engagement.</p>
          </article>
          <article class="experience">
            <p class="experience-kicker">Digital Creativity</p>
            <h3>Writing &amp; App Development</h3>
            <p>I create long-form content on Dcard as <a href="https://www.dcard.tw/@ralfwu0330" target="_blank" rel="noopener noreferrer"><span lang="zh-Hant">左旋葡萄糖</span> ↗</a> and independently developed QuoteSource, an iOS app for tracing quotation sources and assessing their credibility.</p>
            <a class="experience-link" href="/blog#app">Explore QuoteSource →</a>
          </article>
        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
  .page { display: grid; gap: 40px; max-width: 900px; margin-inline: auto; }
  .about-hero { display: grid; grid-template-columns: 200px minmax(0, 1fr); align-items: center; gap: 32px; }
  .portrait { width: 200px; height: 200px; object-fit: cover; border-radius: 28px; box-shadow: 0 12px 32px rgba(26,39,68,.1); }
  .kicker { font-size: 13px; font-weight: 800; letter-spacing: .09em; color: #547295; text-transform: uppercase; margin: 0 0 8px; }
  h1 { font-size: clamp(34px, 5vw, 54px); letter-spacing: -.045em; line-height: 1.1; margin: 0 0 12px; }
  .intro { max-width: 520px; font-size: 18px; line-height: 1.6; margin: 0; color: #46536a; }
  .sections { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; }
  #research ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 36px; }
  #research .education-entry + .education-entry { margin-top: 0; }
  .experience-intro { margin-bottom: 18px !important; }
  .experience-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .experience { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 9px; border: 1px solid #dce3e9; border-radius: 14px; background: rgba(255,255,255,.48); padding: 19px; }
  .experience .experience-kicker { color: #547295; font-size: 11px; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
  .experience h3 { margin: 0; font-size: 17px; line-height: 1.45; letter-spacing: -.015em; overflow-wrap: anywhere; }
  .experience h3 a { text-decoration: none; }
  .experience h3 a:hover { text-decoration: underline; }
  .experience p:not(.experience-kicker) { font-size: 14px; line-height: 1.7; }
  .experience-link { color: #365477; font-weight: 700; font-size: 13px; display: inline-flex; align-items: center; min-height: 44px; margin-top: auto; }
  .section { min-width: 0; border-top: 1px solid #dce3e9; padding: 20px 0 0; scroll-margin-top: 18px; }
  h2 { font-size: 21px; letter-spacing: -.02em; margin: 0 0 14px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  li { display: grid; gap: 3px; line-height: 1.45; }
  li strong { font-size: 16px; font-weight: 750; }
  .education-entry + .education-entry { margin-top: 10px; }
  .education-entry .degree { font-weight: 700; color: #365477; }
  .education-entry .education-note { margin-top: 4px; }
  li span, .section p { color: #4d5c70; font-size: 14px; line-height: 1.55; margin: 0; }
  a { text-underline-offset: 3px; }
  .profile-link { display: inline-flex; gap: 6px; align-items: center; min-height: 44px; color: #365477; font-size: 14px; font-weight: 700; }
  @media (max-width: 600px) {
    .page { gap: 24px; }
    .about-hero { grid-template-columns: 1fr; gap: 16px; align-items: start; }
    .portrait { width: 128px; height: 128px; border-radius: 21px; }
    h1 { font-size: 36px; }
    .intro { font-size: 16px; }
    .sections { grid-template-columns: 1fr; gap: 24px; }
    #research ul, .experience-grid { grid-template-columns: 1fr; gap: 12px; }
    #research .education-entry + .education-entry { margin-top: 6px; }
    .experience { padding: 16px; gap: 7px; }
    .experience p:not(.experience-kicker) { font-size: 15px; }
    .experience-intro { margin-bottom: 14px !important; }
    .section { padding-top: 16px; }
    h2 { font-size: 20px; margin-bottom: 12px; }
      li strong { font-size: 16px; }
    li span, .section p { font-size: 15px; }
  }
</style>
